{
  "name": "akisync-go",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run tests/*.test.ts",
    "test:e2e": "vite build --mode android --outDir .test-android-assets && playwright test",
    "android:sync": "tsc --noEmit && vite build --mode android --outDir dist-android && cap sync android",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.0",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.0",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.0",
    "@playwright/test": "^1.61.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.9.3",
    "vite": "^6.4.6",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=20"
  }
}
